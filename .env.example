# --- Banco (Supabase > Project Settings > Database > Connection string) ---
# IMPORTANTE: use o Session pooler (porta 5432) e o usuário no formato postgres.<project-ref>.
# O host direto (db.<ref>.supabase.co) é IPv6-only e não funciona na Vercel.
# O Transaction pooler (porta 6543) é incompatível com o Prisma em serverless.
DATABASE_URL="postgresql://postgres.<project-ref>:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# --- Auth.js (gere com: openssl rand -base64 32) ---
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# --- Supabase Storage (usado a partir do Módulo 3). NUNCA exponha no frontend ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="contracts"

# --- E-mail (Módulo 5) ---
RESEND_API_KEY=""
EMAIL_FROM="Social Sign <contratos@seudominio.com>"

# --- Segurança ---
# Segredo extra para gerar o hash dos tokens de assinatura (openssl rand -hex 32)
TOKEN_PEPPER=""
# Protege as rotas de cron (lembretes/expiração)
CRON_SECRET=""

# --- Seed (somente para criar o primeiro administrador) ---
SEED_COMPANY_NAME="Minha Empresa"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
